GLOBAL_UNIT_ASSIGNED_CONTEXT((#9052,#9053,#9054)) REPRESENTATION_CONTEXT
('Context #1','3D Context with UNIT and UNCERTAINTY') );
#9052 = ( CONVERSION_BASED_UNIT('R4_DESIGN_UNIT',#9058) LENGTH_UNIT() NAMED_UNIT(#9059) );
#9053 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#9054 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#9055 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#9052,
  'distance_accuracy_value','confusion accuracy');
#9056 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
#9057 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT($,.METRE.) );
#9058 = LENGTH_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.00125),#9057);
#9059 = DIMENSIONAL_EXPONENTS(1.,0.,0.,0.,0.,0.,0.);
ENDSEC;
END-ISO-10303-21;
